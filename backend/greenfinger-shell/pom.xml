<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.github.paganini2008</groupId>
    <artifactId>greenfinger-backend</artifactId>
    <version>2.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>greenfinger-shell</artifactId>
  <packaging>jar</packaging>
  <name>greenfinger-shell</name>
  <description>Greenfinger command line application</description>

  <dependencies>
    <dependency>
      <groupId>com.github.paganini2008</groupId>
      <artifactId>greenfinger-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.github.paganini2008</groupId>
      <artifactId>greenfinger-cluster</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.shell</groupId>
      <artifactId>spring-shell-starter</artifactId>
    </dependency>

    <!-- The shipped CLI carries every extractor engine so all four are usable out of the box -->
    <dependency>
      <groupId>org.htmlunit</groupId>
      <artifactId>htmlunit</artifactId>
    </dependency>
    <dependency>
      <groupId>com.microsoft.playwright</groupId>
      <artifactId>playwright</artifactId>
    </dependency>
    <dependency>
      <groupId>org.seleniumhq.selenium</groupId>
      <artifactId>selenium-java</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.bonigarcia</groupId>
      <artifactId>webdrivermanager</artifactId>
    </dependency>

    <!-- and every database driver the record module can talk to -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
    </dependency>
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.hibernate.orm</groupId>
      <artifactId>hibernate-community-dialects</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
    </dependency>

    <dependency>
      <groupId>com.microsoft.sqlserver</groupId>
      <artifactId>mssql-jdbc</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.oracle.database.jdbc</groupId>
      <artifactId>ojdbc11</artifactId>
      <scope>runtime</scope>
    </dependency>    <dependency>
      <groupId>io.minio</groupId>
      <artifactId>minio</artifactId>
    </dependency>

    <!-- the command line ships the local models, so a new user needs no account anywhere -->
    <dependency>
      <groupId>ai.djl</groupId>
      <artifactId>api</artifactId>
    </dependency>
    <dependency>
      <groupId>ai.djl.huggingface</groupId>
      <artifactId>tokenizers</artifactId>
    </dependency>
    <dependency>
      <groupId>ai.djl.onnxruntime</groupId>
      <artifactId>onnxruntime-engine</artifactId>
    </dependency>
    <dependency>
      <groupId>com.squareup.okhttp3</groupId>
      <artifactId>okhttp-jvm</artifactId>
    </dependency>
  </dependencies>

  <properties>
    <dist.directory>${project.basedir}/../../deploy</dist.directory>
  </properties>

  <build>
    <!-- the version is in the name, as it is for the server jar -->
    <finalName>greenfinger-shell-${project.version}</finalName>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <excludes>
          <!-- shipped beside the jar in bin/config instead, so it can be edited without a rebuild -->
          <exclude>config/**</exclude>
          <exclude>bin/**</exclude>
        </excludes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
              <!-- META-INF/build-info.properties, so the running server can report its own
                   version rather than a number somebody typed into a page -->
              <goal>build-info</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <mainClass>com.github.greenfinger.shell.GreenfingerShellMain</mainClass>
        </configuration>
      </plugin>
      <!--
        Assembles the distribution into backend/greenfinger/bin: the launcher and the executable
        jar side by side under deploy/, which is what run-local.sh expects to find.
        Declared after the boot plugin so it runs once repackage has produced the jar.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <id>assemble-run-conf</id>
            <phase>package</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${dist.directory}</outputDirectory>
              <!-- the point of this execution: an installation's settings survive a rebuild -->
              <overwrite>false</overwrite>
              <resources>
                <resource>
                  <directory>${project.basedir}/src/main/resources/bin</directory>
                  <filtering>false</filtering>
                  <includes>
                    <include>run.conf</include>
                  </includes>
                </resource>
              </resources>
            </configuration>
          </execution>
          <execution>
            <id>assemble-distribution</id>
            <phase>package</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${dist.directory}</outputDirectory>
              <!-- the jar is rebuilt in place, so timestamp comparison would skip the copy -->
              <overwrite>true</overwrite>
              <resources>
                <resource>
                  <directory>${project.basedir}/src/main/resources/bin</directory>
                  <filtering>false</filtering>
                  <!-- run.conf is the one file here a person edits, so it is copied by the
                       execution below with overwrite off: a build gives it to an installation
                       that has none and never touches one that has been filled in -->
                  <excludes>
                    <exclude>run.conf</exclude>
                  </excludes>
                </resource>
                <resource>
                  <directory>${project.build.directory}</directory>
                  <!-- the executable jar goes in lib/, so deploy/ holds the launchers, the
                       configuration and the data rather than half a gigabyte of jar beside them -->
                  <targetPath>lib</targetPath>
                  <includes>
                    <include>greenfinger-shell-${project.version}.jar</include>
                  </includes>
                  <filtering>false</filtering>
                </resource>
                <resource>
                  <directory>${project.basedir}/src/main/resources/config</directory>
                  <targetPath>config</targetPath>
                  <filtering>false</filtering>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
