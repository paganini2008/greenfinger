<?xml version="1.0" encoding="UTF-8"?>
<!--
  Who may sign in.

  There are two roles, and the difference is whether an account can change anything.

    ADMIN     crawl and search: start, pause, edit, replay, delete
    SUPPORT   search only: every page is readable, and no button that writes is offered

  Nothing here is hashed. A password is stored as it is written, because hashing it in a file
  whoever reads the file can also read would only hide that fact from the reader. Keep the file
  itself private: it is not in the repository, and a rebuild leaves one you have edited alone.

  An account can hold both roles: roles="ADMIN,SUPPORT". Changing this file takes a restart.
-->
<users>
  <user name="admin" password="admin123" roles="ADMIN"/>
  <user name="tester" password="tester123" roles="SUPPORT"/>
</users>
