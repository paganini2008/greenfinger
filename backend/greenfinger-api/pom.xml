<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.github.paganini2008</groupId>
    <artifactId>greenfinger-backend</artifactId>
    <version>2.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>greenfinger-api</artifactId>
  <packaging>jar</packaging>
  <name>greenfinger-api</name>
  <description>The web application: REST endpoints, login, and the server the front end talks to</description>

  <dependencies>
    <dependency>
      <groupId>com.github.paganini2008</groupId>
      <artifactId>greenfinger-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.github.paganini2008</groupId>
      <artifactId>greenfinger-cluster</artifactId>
    </dependency>

    <!--
      Health, and only health by default. A container orchestrator needs somewhere to ask whether
      this node is worth sending traffic to, and the cluster's own health contributor reports
      whether it can still see a leader. A node that cannot is running but useless, and without
      this the two look identical.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!--
      The web layer is no longer optional. This module *is* the server: greenfinger-shell is the one
      that runs without a servlet container, and it depends on greenfinger-core alone.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-configuration-processor</artifactId>
      <optional>true</optional>
    </dependency>

    <!--
      The same drivers and engines greenfinger-shell ships, for the same reason: a catalog created
      through the browser must be able to crawl and store exactly what the command line can.
      H2 keeps the zero-install promise; the rest come into play only once .env names them.
    -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.hibernate.orm</groupId>
      <artifactId>hibernate-community-dialects</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>com.microsoft.sqlserver</groupId>
      <artifactId>mssql-jdbc</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.oracle.database.jdbc</groupId>
      <artifactId>ojdbc11</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- htmlunit is the only engine that needs nothing installed, so adaptive works out of the box -->
    <dependency>
      <groupId>org.htmlunit</groupId>
      <artifactId>htmlunit</artifactId>
    </dependency>
    <dependency>
      <groupId>com.microsoft.playwright</groupId>
      <artifactId>playwright</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.seleniumhq.selenium</groupId>
      <artifactId>selenium-java</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>io.github.bonigarcia</groupId>
      <artifactId>webdrivermanager</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>io.minio</groupId>
      <artifactId>minio</artifactId>
    </dependency>
    <dependency>
      <groupId>com.squareup.okhttp3</groupId>
      <artifactId>okhttp-jvm</artifactId>
    </dependency>
    <dependency>
      <groupId>ai.djl</groupId>
      <artifactId>api</artifactId>
    </dependency>
    <dependency>
      <groupId>ai.djl.huggingface</groupId>
      <artifactId>tokenizers</artifactId>
    </dependency>
    <dependency>
      <groupId>ai.djl.onnxruntime</groupId>
      <artifactId>onnxruntime-engine</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <properties>
    <dist.directory>${project.basedir}/../../deploy</dist.directory>
  </properties>

  <build>
    <!-- the version is in the name: two jars in bin/ with the same name and different
         contents is how a node ends up running last week's build -->
    <finalName>greenfinger-api-${project.version}</finalName>
    <resources>
      <resource>
        <directory>${project.basedir}/src/main/resources</directory>
        <excludes>
          <!--
            None of these belongs inside the jar. The launchers go beside it in deploy/; the image
            definitions describe how it is packaged rather than what it does; and the
            configuration is shipped in deploy/config/api so a setting can be changed without a
            rebuild, which is the rule greenfinger-shell's own configuration follows.
          -->
          <exclude>bin/**</exclude>
          <exclude>config/**</exclude>
          <exclude>docker/**</exclude>
        </excludes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
              <!-- META-INF/build-info.properties, so the running server can report its own
                   version rather than a number somebody typed into a page -->
              <goal>build-info</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <mainClass>com.github.greenfinger.api.GreenfingerApiMain</mainClass>
        </configuration>
      </plugin>
      <!--
        Assembles the server into deploy/ beside the command line, so one directory holds both
        faces of the same build. Declared after the boot plugin so it runs once repackage is done.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <id>assemble-distribution</id>
            <phase>package</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${dist.directory}</outputDirectory>
              <overwrite>true</overwrite>
              <resources>
                <!-- what only the server is configured with, in its own directory so it adds to
                     deploy/config/ rather than colliding with the file already there -->
                <resource>
                  <directory>${project.basedir}/src/main/resources/config</directory>
                  <targetPath>config/api</targetPath>
                  <filtering>false</filtering>
                </resource>
                <!-- the two launchers that start a server: they live here rather than in deploy/,
                     because deploy/ is entirely made by the build and nothing in it is committed -->
                <resource>
                  <directory>${project.basedir}/src/main/resources/bin</directory>
                  <filtering>false</filtering>
                </resource>
                <!-- the image definition; the build context is deploy/ itself, because that is
                     where the jar and the front end build are -->
                <resource>
                  <directory>${project.basedir}/src/main/resources/docker</directory>
                  <targetPath>docker</targetPath>
                  <filtering>false</filtering>
                  <excludes>
                    <exclude>dockerignore</exclude>
                  </excludes>
                </resource>
                <!-- docker reads this only at the root of the context, and the resources plugin
                     skips a name starting with a dot, so it is carried under a plain name and
                     renamed on the way -->
                <resource>
                  <directory>${project.basedir}/src/main/resources/docker</directory>
                  <includes>
                    <include>dockerignore</include>
                  </includes>
                  <filtering>false</filtering>
                </resource>
                <resource>
                  <directory>${project.build.directory}</directory>
                  <!-- the executable jar goes in lib/, so deploy/ holds the launchers, the
                       configuration and the data rather than half a gigabyte of jar beside them -->
                  <targetPath>lib</targetPath>
                  <includes>
                    <include>greenfinger-api-${project.version}.jar</include>
                  </includes>
                  <filtering>false</filtering>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
