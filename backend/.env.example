# Greenfinger backend settings. One file, and the only one.
#
# Copy to .env beside this file. It is read two ways and both find it:
#
#   working on the source   Spring's spring.config.import picks it up as ./.env from backend/,
#                           as ../.env from a module directory, or as ./backend/.env from the
#                           project root -- an IDE run needs nothing exported.
#   deployed                the build copies this file into deploy/, where the launchers source
#                           it before starting the jvm. deploy/ is a copy of this tree and holds
#                           no original: delete it and a build puts it back.
#
# Plain KEY=value -- it is parsed as a properties file, so no `export` and no shell quoting.
# Everything has a working default in config/application.yml, so an empty .env is a valid one.
#
# ---- Which profile. dev is zero configuration; prod is your own database and stores. ----
# GF_PROFILE=dev

# ---- Database. dev defaults to an H2 file: nothing to install. prod requires these. ----
# GF_DB_URL=jdbc:postgresql://localhost:5432/greenfinger?currentSchema=public
# GF_DB_USERNAME=greenfinger
# GF_DB_PASSWORD=
# GF_DB_DRIVER=org.postgresql.Driver
# MySQL:  jdbc:mysql://localhost:3306/greenfinger?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC
#         com.mysql.cj.jdbc.Driver
# SQLite: jdbc:sqlite:./data/.state/greenfinger.db  with  org.sqlite.JDBC, and the only database
#         that needs its dialect named, because Hibernate ships none for it:
# GF_DB_DIALECT=org.hibernate.community.dialect.SQLiteDialect

# ---- The server: run-local.sh. The command line needs none of this and has no login. ----
# GF_SERVER_PORT=8080
# GF_API_PREFIX=/v2
# The accounts are not here: they are in config/api/users.xml, one <user> per line, with two
# roles -- ADMIN crawls and searches, SUPPORT searches. Change the passwords in that file.
# This only says where it is, for an installation that keeps it somewhere else.
# GF_USERS_FILE=config/api/users.xml

# What sign-in tokens are signed with. Any long random string; the same one on every node, or a
# browser behind nginx will be asked to sign in again whenever it lands on a different one.
# Left unset, each process makes up its own and says so in the log.
#   openssl rand -base64 48
# GF_TOKEN_SECRET=
# GF_SECURITY_ENABLED=true
# GF_TOKEN_VALIDITY=8h
# Where the front end is served from. The Angular dev server during development; a build served
# by this same jar needs no entry.
# GF_CORS_ORIGINS=http://localhost:4200

# ---- Where the crawl puts things ----
# One directory for everything a node writes, split in two underneath: system/ is what the crawler
# needs while crawling (the frontier, the two dedup stores, and the H2 or SQLite file when no
# database server was configured -- losing it costs a resume, never a search), and user/ is what
# was crawled (assets/, index/, vector/ -- the directory worth backing up).
#
# Empty means data/ beside the launcher, so where you happened to cd to does not decide where a
# crawl is written. **Worth setting to somewhere outside deploy/**: everything else there is made
# by the build and `rm -rf deploy` is the ordinary way to upgrade, which with the default takes
# every page you have ever crawled with it.
#
#     GF_DATA_STORE=/var/lib/greenfinger
#
# One writer per store: the frontier and the dedup stores are RocksDB and take an exclusive lock,
# so a process that crawls wants a store of its own. run-local.sh and run-docker.sh give each node
# one under GF_DATA_ROOT (run.conf) for exactly that reason.
# GF_DATA_STORE=
# GF_DATA_DIR=./data
# GF_STATE_DIR=./data/.state
# GF_OUTPUT_TYPES=file            # file, index, vector -- combine with commas

# ---- Files: local disk, or MinIO with the identical layout ----
# GF_FILE_TARGET=local            # local | minio
# GF_MINIO_ENDPOINT=http://localhost:19000
# GF_MINIO_ACCESS_KEY=
# GF_MINIO_SECRET_KEY=
# GF_MINIO_BUCKET=greenfinger

# ---- The page. Served by docker/server.js under Node, one address in front of every node. ----
# Whether it is started at all is GF_WEB in run.conf; these are what it runs on.
# GF_WEB_PORT=9700
# The api address written into the app's env.js and read by the browser. Empty is right when the
# page forwards /v2 itself, which both launchers make it do; name it only when the api is
# somewhere else -- its own domain, or an nginx or Kong in front of it.
# GF_API_BASE_URL=
# Whether the page asks the cluster for its members and spreads requests across them. 0 pins it
# to the node it was given, which is what you want in front of a load balancer that already does.
# GF_DISCOVER=1

# ---- Cluster. Nodes agreeing on the name AND the port find each other and share one crawl. ----
# The launchers name their own -- greenfinger-cli.sh takes --cluster, run-local.sh uses
# "greenfinger-local" on 22010 and run-docker.sh "greenfinger-docker" on 22020 -- so a set of
# containers left running neither merges with nodes started by hand nor takes their election port.
# Naming one here makes every launcher on this machine join that one instead.
#
# Give both halves or neither. Holding a port is machine wide rather than per cluster, so a second
# cluster with its own name on the same port never elects anybody: the port is taken by a node it
# does not consider a member, and everything works except the things that need a leader.
# GF_CLUSTER_NAME=default
# GF_CLUSTER_PORT=22000
#
# Other machines to knock on, comma separated, when the cluster spans more than this one. Empty
# finds the other processes on this machine and nothing else. Setting it also unpins the address a
# node advertises -- fixed at 127.0.0.1 so several processes on one machine do not advertise an
# interface none of them can reach -- and GF_CLUSTER_ADVERTISE_HOST names it explicitly.
# GF_CLUSTER_HOSTS=127.0.0.1
# GF_CLUSTER_ADVERTISE_HOST=

# ---- Full text search. Embedded by default: nothing to install. ----
# One index per catalog, named <prefix>-<catalog id>, holding every version of it.
# GF_INDEX_PROVIDER=lucene        # lucene | elasticsearch
# GF_INDEX_PREFIX=greenfinger
# GF_LUCENE_ANALYZER=standard     # standard | smartcn | cjk
#   standard is right for English, which is what is mostly crawled. smartcn is a real Chinese
#   segmenter -- the embedded counterpart of installing IK -- and cjk is bigrams, no dictionary.
# GF_LUCENE_COMMIT_EVERY=1000
# ---- ... or a real Elasticsearch, when one machine is not enough ----
# GF_ES_URIS=http://localhost:9200
# GF_ES_ANALYZER=standard         # ik_max_word and ik_smart need the IK plugin installed

# ---- Semantic and cross modal search. Embedded by default too. ----
# Lucene's HNSW is what Elasticsearch's own knn search is built on.
# GF_VECTOR_STORE=lucene          # lucene | qdrant | weaviate
# GF_LUCENE_SIMILARITY=cosine     # cosine | dot | euclidean
# GF_QDRANT_URL=http://localhost:6333
# GF_WEAVIATE_URL=http://localhost:18080/v1

# ---- Embeddings. "local" runs the models here: no account, no quota. ----
# GF_EMBEDDING_PROVIDER=local     # local | ollama | openai
# GF_MODEL_DIR=~/.greenfinger/models
# GF_EMBEDDING_OFFLINE=false      # refuse to download; fail instead if not cached
# GF_OLLAMA_URL=http://localhost:11434
# GF_OLLAMA_MODEL=qwen3-embedding:4b

# The only value that is genuinely secret. Needed solely for the openai provider.
# OPENAI_API_KEY=sk-...

# ---- Merge (update --refresh) ----
# Revisiting every known page needs room for all of them, so raise this before a merge.
# GF_MAX_FETCH_SIZE=100000

# ---- Javascript ----
# The default, adaptive, fetches over http and renders only the pages that came back empty, so a
# static site never starts a browser. Set restclient to never render, or name an engine to always.
# GF_EXTRACTOR=adaptive            # adaptive | restclient | htmlunit | playwright | selenium
# GF_ADAPTIVE_BROWSER=htmlunit     # which browser adaptive falls back to.
#                                  #   htmlunit   nothing to install, engine is in the jar
#                                  #   playwright better rendering; needs `playwright install`
#                                  #   selenium   better rendering; needs a browser on the machine

# ---- Crawl defaults ----
# GF_WORK_THREADS=16
# GF_MAX_FETCH_SIZE=10000
# GF_FETCH_INTERVAL=1000
# GF_MAX_VERSIONS=10
# GF_LOG_LEVEL=WARN

# ---- When a crawl is over ----
# How long a crawl may stand still before it is wound up, and how often that is checked. Standing
# still with every dispatched url handled means the site ran out of urls: the crawl is finished and
# the version is published without waiting out fetchDuration. Standing still with urls unaccounted
# for means a node stopped answering: the run ends and publishes nothing.
#
# It is therefore also how long a site smaller than maxFetchSize waits after its last page. Lower
# it for small sites; raise it where a single fetch can take minutes.
# GF_IDLE_TIMEOUT=2m
# GF_COMPLETION_CHECK_INTERVAL=5s
#
# How many fetches in a row may come back with nothing -- anything outside 2xx and 3xx, and the
# requests that never got a status -- before the crawl gives up on the site. In a row, and reset by
# the first page that comes back, so a members-only corner of an open site ends nothing. The crawl
# ends the way an interrupt does, so nothing is published. 0 leaves the timeout as the only
# backstop.
# GF_MAX_CONSECUTIVE_FAILURES=20

# How many processes to start, on which ports, with how much heap, and the docker network: those
# are shell questions rather than application ones, and they are in run.conf beside this file.
