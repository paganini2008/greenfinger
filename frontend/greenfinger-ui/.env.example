# Settings for working on the front end. Copy to .env and change what you need.
#
# One file, one reader: tools/env.cjs. Anything already in the environment wins, so a one-off
# stays a one-off --  GF_API_PORT=50081 npm start  --  and .env is not in the repository.
#
# What runs the built page in a deployment is configured elsewhere: run-local.sh and
# run-docker.sh pass PORT, GF_STATIC, GF_UPSTREAMS and GF_DISCOVER to docker/server.js from
# deploy/, because those describe an installation rather than this working copy.

# The version the badge shows and package.json is stamped with. Empty keeps what package.json has.
# GF_VERSION=2.0.0-SNAPSHOT

# Where `npm start` serves the page.
# GF_DEV_PORT=9700

# Where the dev server forwards /v2 and /actuator. 50080 is run-local.sh's first node.
# GF_API_PORT=50080

# The api address baked into the served page, for a page served from somewhere else than the api.
# Empty means same origin, which is what a jar serving both wants.
# GF_API_BASE_URL=

# What `npm run e2e` drives. Unset means the dev server's own port above.
# GF_E2E_URL=http://localhost:9700

# The catalog the read-only e2e specs read. Unset means the suite makes its own, 'e2e-corpus'.
# GF_E2E_CATALOG=
